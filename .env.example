# Copiar este archivo como .env y ajustar los valores.
# La usan docker compose (contenedor de la API) y "npm run dev" en la carpeta api.
# En Docker, docker-compose.yml cambia DB_HOST a host.docker.internal y PORT a 3000.

# Puertos en la PC (docker compose)
WEB_PORT=8090
API_PORT=8091

# API
PORT=3000
# 1 = muestra el detalle de los errores (solo en desarrollo)
APP_DEBUG=1
# Firma de los tokens de sesión (JWT): un texto largo y secreto, por ejemplo:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambie-este-secreto
# Duración de la sesión en segundos (8 horas)
JWT_TTL=28800
CORS_ORIGEN=*

# MySQL: el contenedor de MySQL publica el puerto 3306 en la PC
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=transport_db
DB_USER=transport_app
DB_PASS=TransPort_2026

# Notificaciones push: generar las llaves con  npx web-push generate-vapid-keys
# Sin llaves, la API funciona igual pero no envía notificaciones push (solo alertas en el portal)
VAPID_PUBLICA=
VAPID_PRIVADA=
VAPID_CONTACTO=mailto:soporte@transport.test

# Servicio de GPS-Inversiones: token que envía en el encabezado X-GPS-Token
GPS_TOKEN=gps-demo-2026

# Tareas programadas (recordatorios y revisión diaria a las 7:00): 0 para desactivarlas
TAREAS=1
# Horario normal de la maquinaria: fuera de él, el GPS genera la alerta "uso fuera de horario"
HORARIO_INICIO=6
HORARIO_FIN=19
